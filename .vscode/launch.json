{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Docker: Python - Fastapi",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "python": {
                "pathMappings": [
                    {
                        "localRoot": "${ai-dev-assistant}/backend",
                        "remoteRoot": "/app"
                    }
                ],
                "projectType": "fastapi",
                "module": "uvicorn",
                "args": [
                    "app.main:app",
                    "--reload"
                ],
                "console": "integratedTerminal"
                }
        },
        {
            "name": "Frontend",
            "type": "node",
            "request": "launch",
            "program": "${ai-dev-assistant}/frontend/src/index.js",
            "cwd": "${ai-dev-assistant}/frontend"
    
        }  
   ]
}